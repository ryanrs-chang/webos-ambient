{
  "name": "webos-ambient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clock and weather ambient display for LG webOS TVs",
  "scripts": {
    "build": "bun run build:css && bun run build:js",
    "build:css": "tailwindcss -i src/tailwind.css -o app/style.css --minify",
    "build:js": "bun scripts/build-js.ts",
    "setup": "bun scripts/setup.ts",
    "check:secrets": "bun scripts/check-secrets.ts",
    "dev": "bun run build && bun scripts/dev.ts",
    "icons": "rsvg-convert -w 80 -h 80 assets/icon.svg -o app/icon.png && rsvg-convert -w 130 -h 130 assets/icon.svg -o app/largeIcon.png",
    "package": "bun run build && rm -rf dist && mkdir dist && ares-package app -o dist",
    "install:tv": "ares-install -d tv dist/*.ipk",
    "launch:tv": "ares-launch -d tv dev.ryanrs.ambient",
    "inspect:tv": "ares-inspect -d tv --app dev.ryanrs.ambient --open",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "latest",
    "@webos-tools/cli": "3.2.6",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "fstream@1.0.12": "patches/fstream@1.0.12.patch"
  }
}
